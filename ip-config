#!/bin/bash
# NetworkManager backend for the IP config shell plugin.
#
#   ip-config list                  One TSV line per Wi-Fi/Ethernet adapter:
#                                   device type enabled connection method address state
#                                   lease-expiry (epoch seconds, DHCP only)
#   ip-config toggle <dev>          Wi-Fi: radio off/on. Ethernet: disconnect/connect the device.
#   ip-config dhcp <dev>            Switch to DHCP, saving the current static settings first.
#   ip-config static <dev> <input>  input = "IP[/mask] [gateway] [dns...]", or "dhcp".
#                                   A missing mask means /24; missing DNS uses the gateway.
#   ip-config watch                 Stream DHCP progress for all adapters (see cmd_watch).
#   ip-config setup-logging         Optional, run by hand: turn on DHCP packet logging (root).
#   ip-config remove-logging        Undo setup-logging (root).
#   ip-config prefill <dev>         Current static settings, or the ones saved by the last
#                                   switch to DHCP, as "IP/mask gateway dns...".
#   ip-config setup                 Guided setup, asking first about each step: add IP config
#                                   to Setup > Network in the Omarchy menu, bind SUPER + ALT + N,
#                                   and (optional, root) DHCP packet logging. --yes takes the
#                                   first two without asking, and never the logging.
#   ip-config remove-shortcuts      Undo the menu entry and key from setup.
#   ip-config offer-setup           Run by the plugin on load: offers setup once, in a
#                                   notification.
#
# dhcp and static report the connection stages while it comes back up, one
# "status<TAB>text" line per stage. DHCP packet steps come from `watch`.

set -uo pipefail

# Static settings are saved on the NetworkManager profile itself (as user data),
# so they survive a switch to DHCP no matter what tool set them.
SAVED_KEY=ip-config.static-ipv4

notify() { notify-send -a "IP config" "$@"; }

fail() {
  notify -u critical "$@"
  exit 1
}

dev_field() { nmcli -g "$1" dev show "$2" 2>/dev/null; }
con_field() { nmcli -g "$1" con show "$2" 2>/dev/null; }

# The profile the device is using now, else the most recently used profile for it.
dev_profile() {
  local dev=$1 type name t ts best="" best_ts=-1 key val
  local -a names=()
  local -A stamp iface
  # Type and active profile in one call.
  { read -r t; IFS= read -r name; } < <(nmcli -g GENERAL.TYPE,GENERAL.CONNECTION dev show "$dev" 2>/dev/null)
  if [[ -n $name ]]; then
    echo "$name"
    return
  fi
  [[ $t == wifi ]] && type=802-11-wireless || type=802-3-ethernet
  while IFS=: read -r t ts name; do
    [[ $t == "$type" ]] || continue
    name=${name//\\:/:}
    names+=("$name")
    stamp[$name]=$ts
  done < <(nmcli -t -f TYPE,TIMESTAMP,NAME con show)
  ((${#names[@]})) || return 0
  while IFS= read -r line; do
    key=${line%%:*}
    val=${line#*:}
    case "$key" in
      connection.id) name=$val ;;
      connection.interface-name) iface[$name]=$val ;;
    esac
  done < <(nmcli -t -e no -f connection.id,connection.interface-name con show "${names[@]}")
  for name in "${names[@]}"; do
    [[ -z ${iface[$name]:-} || ${iface[$name]} == "$dev" ]] || continue
    if ((${stamp[$name]:-0} > best_ts)); then best=$name; best_ts=${stamp[$name]:-0}; fi
  done
  [[ -n $best ]] && echo "$best"
}

# A profile's saved user data, read over D-Bus (much faster than starting libnm).
user_data_get() {
  local con=$1 key=$2 path="" line name
  # DBUS-PATH first: it has no colons, while the (escaped) name may.
  while IFS= read -r line; do
    name=${line#*:}
    name=${name//\\:/:}
    if [[ $name == "$con" ]]; then path=${line%%:*}; break; fi
  done < <(nmcli -t -f DBUS-PATH,NAME con show)
  [[ -n $path ]] || return 0
  gdbus call --system --dest org.freedesktop.NetworkManager --object-path "$path" \
    --method org.freedesktop.NetworkManager.Settings.Connection.GetSettings |
    grep -o "'$key': '[^']*'" | sed "s/^'$key': '//; s/'\$//"
}

# nmcli can't write profile user data, so saving goes through libnm.
user_data() {
  python3 - "$@" <<'PY'
import sys, warnings, gi
warnings.filterwarnings("ignore", category=DeprecationWarning)
gi.require_version("NM", "1.0")
from gi.repository import NM

op, name, key = sys.argv[1:4]

def run():
    con = next((c for c in NM.Client.new(None).get_connections() if c.get_id() == name), None)
    if con is None:
        sys.exit(1)
    setting = con.get_setting(NM.SettingUser)
    if op == "get":
        print((setting.get_data(key) if setting else None) or "")
        return
    if setting is None:
        setting = NM.SettingUser.new()
        con.add_setting(setting)
    setting.set_data(key, sys.argv[4])
    con.commit_changes(True, None)

# A profile that changed under us ("no longer in the client cache") is
# transient; a fresh client sees the current one.
try:
    run()
except Exception:
    run()
PY
}

# "IP/mask gateway dns..." from a profile's current ipv4 settings.
static_line() {
  local con=$1 addr gw dns
  addr=$(con_field ipv4.addresses "$con" | cut -d, -f1 | tr -d ' ')
  gw=$(con_field ipv4.gateway "$con")
  dns=$(con_field ipv4.dns "$con" | tr ',' ' ')
  [[ -n $addr ]] && echo "$addr${gw:+ $gw}${dns:+ $dns}"
}

status() { printf 'status\t%s\n' "$1"; }

# NetworkManager device state -> progress text. NM's DHCP client doesn't expose
# the individual DHCP packets, so this is as fine-grained as it gets.
stage_text() {
  local method=$1
  case "${2%% *}" in
    110) echo "Releasing old address…" ;;
    40) echo "Preparing…" ;;
    50) echo "Configuring link…" ;;
    60) echo "Authenticating…" ;;
    70) [[ $method == auto ]] && echo "Requesting DHCP lease…" || echo "Setting address…" ;;
    80) echo "Checking address…" ;;
    90) echo "Starting…" ;;
  esac
}

# Reading NetworkManager's journal needs wheel, systemd-journal or adm membership.
journal_readable() { [[ -n $(journalctl -u NetworkManager -n 1 -q -o cat 2>/dev/null) ]]; }

# Bring the profile up, reporting each stage of the activation as it happens.
# DHCP itself is reported by `ip-config watch`, which the plugin runs while open.
activate() {
  local dev=$1 con=$2 method out pid rc code text last="" packets=0
  method=$(con_field ipv4.method "$con")
  # The watcher's DHCP packet steps stand in for the generic "requesting"
  # stage, but only when it can read the journal.
  [[ $method == auto ]] && journal_readable && packets=1
  out=$(mktemp)
  # ifname pins the activation to this adapter; Wi-Fi profiles usually aren't
  # bound to one, and NM could otherwise bring the profile up elsewhere.
  nmcli con up "$con" ifname "$dev" >"$out" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    code=$(dev_field GENERAL.STATE "$dev")
    code=${code%% *}
    if ((packets)) && [[ $code == 70 ]]; then text=""; else text=$(stage_text "$method" "$code"); fi
    if [[ -n $text && $text != "$last" ]]; then
      status "$text"
      last=$text
    fi
    sleep 0.15
  done
  wait "$pid"
  rc=$?
  if ((rc != 0)); then
    notify -u critical "Failed: $con" "$(cat "$out")"
    rm -f "$out"
    exit 1
  fi
  rm -f "$out"
}

# Modify the adapter's profile, then reactivate it if the adapter is up.
# A disabled or unplugged adapter just keeps the saved settings.
apply() {
  local dev=$1 con out
  shift
  con=$(dev_profile "$dev")
  [[ -n $con ]] || fail "No profile for $dev"
  out=$(nmcli con mod "$con" "$@" 2>&1) || fail "Failed: $con" "$out"
  if [[ -n $(dev_field GENERAL.CONNECTION "$dev") ]]; then
    activate "$dev" "$con"
  fi
}

# Follows NetworkManager's journal and reports DHCP progress for every adapter,
# whoever started it (this plugin, a cable being plugged in, a reconnect):
#   event<TAB>device<TAB>text     (empty text: the lease is done)
# Steps are reported as they happen; the plugin paces them for display.
cmd_watch() {
  local line dev ip text
  declare -A last canceled
  coproc JOURNAL { exec journalctl -u NetworkManager -f -n 0 -o cat 2>/dev/null; }
  trap 'kill "$JOURNAL_PID" 2>/dev/null' EXIT
  trap 'exit 0' TERM INT
  while IFS= read -r line <&"${JOURNAL[0]}"; do
    [[ $line =~ dhcp4\ \(([^\)]+)\):\ (.*) ]] || continue
    dev=${BASH_REMATCH[1]}
    line=${BASH_REMATCH[2]}
    ip=""
    [[ $line =~ \ of\ ([0-9.]+) ]] && ip=${BASH_REMATCH[1]}
    # Tearing a connection down logs "canceled DHCP transaction" immediately
    # followed by a "beginning transaction" that never goes anywhere; skip it.
    if [[ $line == "canceled DHCP transaction"* ]]; then
      canceled[$dev]=1
      continue
    fi
    if [[ -n ${canceled[$dev]:-} ]]; then
      unset "canceled[$dev]"
      [[ $line == "activation: beginning transaction"* ]] && continue
    fi
    case "$line" in
      "activation: beginning transaction"*) text="Starting DHCP…" ;;
      "event: send DISCOVER"*) text="Discover…" ;;
      "event: received OFFER"*) text="Offer${ip:+ $ip}" ;;
      "event: send REQUEST"*) text="Request${ip:+ $ip}" ;;
      "event: received ACK"*) text="Ack${ip:+ $ip}" ;;
      "event: received NACK"*) text="Nak, retrying…" ;;
      "state changed new lease, address="*"acd pending"*) text="Checking for conflicts…" ;;
      "state changed new lease, address="*) text="" ;;
      *) continue ;;
    esac
    [[ -n $text && $text == "${last[$dev]:-}" ]] && continue
    last[$dev]=$text
    printf 'event\t%s\t%s\n' "$dev" "$text"
  done
}

# Optional DHCP packet logging, set up and removed by the user by hand (the
# plugin never runs these). Both need root, via polkit, and touch only:
#   - LOG_CONF, which must be absent or a regular file this plugin wrote
#     (the marker line, or the header of the pre-marker file from 1.0.0–1.1.0);
#   - the DHCP4 entry of NetworkManager's log domains. Every other domain and
#     the overall level stay as they are, now and in the saved config.
LOG_CONF=/etc/NetworkManager/conf.d/90-ip-config-dhcp-log.conf
LOG_MARKER="# Managed by the IP config Omarchy plugin (io.github.fivefold3.ip-config)."
LOG_OLD_HEADER="# Optional, for the IP config plugin: log DHCPv4 packets (DISCOVER, OFFER,"

log_conf_is_ours() { grep -qxF -e "$LOG_MARKER" -e "$LOG_OLD_HEADER" "$1" 2>/dev/null; }

# Why LOG_CONF can't be touched, or nothing if it can. Checked as the user
# before asking for a password; the privileged side checks again.
log_conf_problem() {
  if [[ -L $LOG_CONF ]]; then
    echo "$LOG_CONF is a symlink; leaving it alone."
  elif [[ -e $LOG_CONF && -r $LOG_CONF ]] && ! log_conf_is_ours "$LOG_CONF"; then
    echo "$LOG_CONF was not created by this plugin; leaving it alone."
  fi
  # Unreadable: can't tell from here; the privileged check decides.
}

# The same guard for the privileged POSIX sh scripts below ($conf, $marker
# and $old are set by the caller). Symlinks are refused rather than followed.
# The values it receives are also checked there, so nothing unexpected is
# written as root even though they come from the same user.
LOG_CONF_GUARD='
  dir=$(dirname "$conf")
  if [ -L "$dir" ] || [ -L "$conf" ]; then echo "$conf is or is under a symlink; leaving it alone." >&2; exit 3; fi
  if [ -e "$conf" ] && ! grep -qxF -e "$marker" -e "$old" "$conf"; then
    echo "$conf was not created by this plugin; leaving it alone." >&2
    exit 3
  fi
  case "$level" in INFO|WARN|ERR|DEBUG|TRACE|OFF) ;; *) echo "unexpected log level: $level" >&2; exit 1 ;; esac
  case "$domains" in *[!A-Z0-9:,_-]*|"") echo "unexpected log domains: $domains" >&2; exit 1 ;; esac
'

# Runtime log level and domains into LOG_LEVEL / LOG_DOMAINS; fails when
# NetworkManager isn't answering, so nothing is changed on a guess.
read_logging() {
  IFS=: read -r LOG_LEVEL LOG_DOMAINS < <(nmcli -t -f LEVEL,DOMAINS general logging 2>/dev/null)
  LOG_DOMAINS=${LOG_DOMAINS//\\:/:}   # nmcli -t escapes colons
  [[ -n $LOG_LEVEL ]]
}

dhcp4_debug() { [[ ,$LOG_DOMAINS, == *,DHCP4:DEBUG,* || ,$LOG_DOMAINS, == *,DHCP4:TRACE,* ]]; }

# LOG_DOMAINS with the DHCP4 entry set to $1 ("" = inherit the level).
domains_with_dhcp4() {
  local rest
  rest=$(tr ',' '\n' <<<"$LOG_DOMAINS" | grep -v '^DHCP4\(:.*\)\?$' | paste -sd,)
  echo "${rest:+$rest,}DHCP4${1:+:$1}"
}

# The domains line to write. Keep the one already in our file. For a fresh
# file, add to any domains setting elsewhere in the config rather than
# replacing it; with none set, "+=" alone would leave only DHCP4 enabled, so
# include the defaults. The merged config is consulted only when our file is
# absent, since otherwise it would just reflect our own contribution.
log_conf_line() {
  local existing
  if [[ -f $LOG_CONF ]]; then
    existing=$(grep -m1 '^domains+=' "$LOG_CONF" 2>/dev/null) && { echo "$existing"; return; }
    echo "domains+=DEFAULT,DHCP4:DEBUG"   # the pre-marker file replaced domains= outright; play safe
  elif NetworkManager --print-config 2>/dev/null | grep -q '^domains='; then
    echo "domains+=DHCP4:DEBUG"
  else
    echo "domains+=DEFAULT,DHCP4:DEBUG"
  fi
}

cmd_setup_logging() {
  local problem line
  problem=$(log_conf_problem)
  [[ -z $problem ]] || { echo "$problem" >&2; return 3; }
  read_logging || { echo "NetworkManager isn't answering; is it running?" >&2; return 1; }
  if dhcp4_debug && [[ -f $LOG_CONF ]] && grep -qxF "$LOG_MARKER" "$LOG_CONF" 2>/dev/null \
      && grep -q '^domains+=' "$LOG_CONF" 2>/dev/null; then
    echo "DHCP packet logging is already on."
    return 0
  fi
  line=$(log_conf_line)
  # Written to a temp file and renamed into place, so nothing at the path is
  # ever followed or partially overwritten.
  pkexec /bin/sh -c 'conf=$1 marker=$2 old=$3 line=$4 level=$5 domains=$6'"$LOG_CONF_GUARD"'
    case "$line" in "domains+="*) ;; *) echo "unexpected config line: $line" >&2; exit 1 ;; esac
    case "${line#domains+=}" in *[!A-Z0-9:,_-]*|"") echo "unexpected config line: $line" >&2; exit 1 ;; esac
    mkdir -p "$dir" && tmp=$(mktemp "$dir/.ip-config.XXXXXX") || exit 1
    trap '\''rm -f "$tmp"'\'' EXIT
    printf "%s\n%s\n%s\n" "$marker" "[logging]" "$line" >"$tmp" &&
      chmod 644 "$tmp" && mv -f "$tmp" "$conf" &&
      nmcli general logging level "$level" domains "$domains"
  ' sh "$LOG_CONF" "$LOG_MARKER" "$LOG_OLD_HEADER" "$line" "$LOG_LEVEL" "$(domains_with_dhcp4 DEBUG)" &&
    echo "DHCP packet logging is on."
}

cmd_remove_logging() {
  local problem
  problem=$(log_conf_problem)
  [[ -z $problem ]] || { echo "$problem" >&2; return 3; }
  read_logging || { echo "NetworkManager isn't answering; is it running?" >&2; return 1; }
  if ! dhcp4_debug && [[ ! -e $LOG_CONF && ! -L $LOG_CONF ]]; then
    echo "DHCP packet logging is already off."
    return 0
  fi
  pkexec /bin/sh -c 'conf=$1 marker=$2 old=$3 level=$4 domains=$5'"$LOG_CONF_GUARD"'
    if [ -e "$conf" ]; then rm -f "$conf" || exit 1; fi
    nmcli general logging level "$level" domains "$domains"
  ' sh "$LOG_CONF" "$LOG_MARKER" "$LOG_OLD_HEADER" "$LOG_LEVEL" "$(domains_with_dhcp4 "")" &&
    echo "DHCP packet logging is off."
}

# Runs every 1.5s while the menu is open, so it makes four nmcli calls in
# total rather than several per adapter.
cmd_list() {
  local wifi_radio key val dev type state con enabled method addr expiry name t ts
  local -a devs=() profiles=()
  local -A dtype dstate dcon daddr dexpiry ptype pstamp piface pmethod paddr
  wifi_radio=$(nmcli radio wifi)

  # Every device in one call: blocks of KEY:VALUE lines.
  while IFS= read -r line; do
    key=${line%%:*}
    val=${line#*:}
    case "$key" in
      GENERAL.DEVICE) dev=$val; devs+=("$dev") ;;
      GENERAL.TYPE) dtype[$dev]=$val ;;
      GENERAL.STATE) val=${val#* (}; dstate[$dev]=${val%)} ;;
      GENERAL.CONNECTION) dcon[$dev]=$val ;;
      IP4.ADDRESS\[1\]) daddr[$dev]=$val ;;
      DHCP4.OPTION*) [[ $val == "expiry = "* ]] && dexpiry[$dev]=${val#expiry = } ;;
    esac
  done < <(nmcli -t -f GENERAL.DEVICE,GENERAL.TYPE,GENERAL.STATE,GENERAL.CONNECTION,IP4.ADDRESS,DHCP4.OPTION dev show)

  # Wi-Fi/Ethernet profiles. NAME goes last since it may itself contain colons.
  while IFS=: read -r t ts name; do
    [[ $t == 802-11-wireless || $t == 802-3-ethernet ]] || continue
    name=${name//\\:/:}
    profiles+=("$name")
    ptype[$name]=$t
    pstamp[$name]=$ts
  done < <(nmcli -t -f TYPE,TIMESTAMP,NAME con show)

  # Their settings, again in one call.
  if ((${#profiles[@]})); then
    while IFS= read -r line; do
      key=${line%%:*}
      val=${line#*:}
      case "$key" in
        connection.id) name=$val ;;
        connection.interface-name) piface[$name]=$val ;;
        ipv4.method) pmethod[$name]=$val ;;
        ipv4.addresses) paddr[$name]=${val%%,*} ;;
      esac
    done < <(nmcli -t -e no -f connection.id,connection.interface-name,ipv4.method,ipv4.addresses con show "${profiles[@]}")
  fi

  for dev in "${devs[@]}"; do
    type=${dtype[$dev]}
    state=${dstate[$dev]}
    case "$type" in
      wifi) [[ $wifi_radio == enabled ]] && enabled=1 || enabled=0 ;;
      ethernet) [[ $state == disconnected || $state == unmanaged ]] && enabled=0 || enabled=1 ;;
      *) continue ;;
    esac
    con=${dcon[$dev]:-}
    if [[ -z $con ]]; then
      # Not connected: the most recently used profile that fits this device.
      [[ $type == wifi ]] && t=802-11-wireless || t=802-3-ethernet
      ts=-1
      for name in "${profiles[@]}"; do
        [[ ${ptype[$name]} == "$t" ]] || continue
        [[ -z ${piface[$name]:-} || ${piface[$name]} == "$dev" ]] || continue
        if ((${pstamp[$name]:-0} > ts)); then con=$name; ts=${pstamp[$name]:-0}; fi
      done
    fi
    method=""
    [[ -n $con ]] && method=${pmethod[$con]:-}
    addr=${daddr[$dev]:-}
    # A static adapter that is down still shows its configured address.
    [[ -z $addr && $method == manual ]] && addr=${paddr[$con]:-}
    expiry=""
    [[ $method == auto && -n $addr ]] && expiry=${dexpiry[$dev]:-}
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$dev" "$type" "$enabled" "$con" "$method" "$addr" "$state" "$expiry"
  done
}

cmd_toggle() {
  local dev=$1 state out
  if [[ $(dev_field GENERAL.TYPE "$dev") == wifi ]]; then
    if [[ $(nmcli radio wifi) == enabled ]]; then
      nmcli radio wifi off
    else
      nmcli radio wifi on
    fi
    return
  fi
  state=$(dev_field GENERAL.STATE "$dev")
  # Unplugged: nothing to disconnect, and connecting can't succeed.
  [[ $state == *"(unavailable)"* ]] && return 0
  if [[ $state == *"(disconnected)"* || $state == *"(unmanaged)"* ]]; then
    out=$(nmcli dev connect "$dev" 2>&1) || fail "Failed: $dev" "$out"
  else
    out=$(nmcli dev disconnect "$dev" 2>&1) || fail "Failed: $dev" "$out"
  fi
}

cmd_dhcp() {
  local dev=$1 con line
  con=$(dev_profile "$dev")
  [[ -n $con ]] || fail "No profile for $dev"
  if [[ $(con_field ipv4.method "$con") != manual ]]; then
    # Already DHCP: just renew. The profile (including any DNS override the
    # user set on it) is left exactly as it is.
    [[ -n $(dev_field GENERAL.CONNECTION "$dev") ]] && activate "$dev" "$con"
    return
  fi
  line=$(static_line "$con")
  [[ -n $line ]] && user_data set "$con" "$SAVED_KEY" "$line"
  apply "$dev" ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns ""
}

cmd_static() {
  local dev=$1 words ip gw dns
  read -ra words <<<"${2:-}"
  ip=${words[0]:-}
  gw=${words[1]:-}
  dns=$(IFS=,; echo "${words[*]:2}")
  [[ -n $ip ]] || return 0
  if [[ ${ip,,} == dhcp ]]; then
    cmd_dhcp "$dev"
    return
  fi
  [[ $ip == */* ]] || ip="$ip/24"
  apply "$dev" ipv4.method manual ipv4.addresses "$ip" ipv4.gateway "$gw" ipv4.dns "${dns:-$gw}"
}

cmd_prefill() {
  local con
  con=$(dev_profile "$1")
  [[ -n $con ]] || return 0
  if [[ $(con_field ipv4.method "$con") == manual ]]; then
    static_line "$con"
  else
    user_data_get "$con" "$SAVED_KEY"
  fi
}

# Omarchy shortcuts: a "Setup > Network > IP config" menu row and a key.
# They live in the user's own config files, so they're only ever added when
# the user says yes, and every edit is held to these rules:
#   - Only a block between this plugin's marker lines is added or removed;
#     nothing else in the file changes, and a block that was edited by hand
#     is left alone.
#   - Files that are symlinks or belong to someone else aren't touched.
#   - The menu file must parse the way the Omarchy menu parses it, before and
#     after, with the same entries apart from ours.
#   - Writes go through a temp file and a rename, and are abandoned if the
#     file changed in the meantime.
PLUGIN_ID=io.github.fivefold3.ip-config
SHORTCUT_KEY="SUPER + ALT + N"
BINDINGS_FILE=$HOME/.config/hypr/bindings.lua
MENU_FILE=$HOME/.config/omarchy/extensions/omarchy-menu.jsonc
OFFERED_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/ip-config/setup-offered

# shortcut_block <has|add|remove> <menu|key> <file>
#   has: 0 = our block is there, 1 = it isn't, 3 = can't tell or can't edit.
#   add/remove: 0 = done (or nothing to do), 3 = refused, with the reason on stderr.
shortcut_block() {
  python3 -I - "$@" "$PLUGIN_ID" "$SHORTCUT_KEY" <<'PY'
import json, os, re, sys, tempfile

op, kind, path, plugin_id, key = sys.argv[1:6]

def refuse(msg):
    print(f"{path}: {msg}", file=sys.stderr)
    sys.exit(3)

if kind == "menu":
    begin, end = f"  // >>> {plugin_id} >>>", f"  // <<< {plugin_id} <<<"
    entry_id = "setup.network.ip-config"
    entry = {
        "icon": "󰈀",
        "label": "IP config",
        "description": "DHCP or static IP per adapter",
        "aliases": ["ip", "ipconfig", "static-ip"],
        # Hides the row if the plugin is removed without remove-shortcuts.
        "when": f"[[ -x ~/.config/omarchy/plugins/{plugin_id}/ip-config ]]",
        "action": f"omarchy-shell shell summon {plugin_id}",
    }
    body = [f"  {json.dumps(entry_id)}: {json.dumps(entry, ensure_ascii=False, separators=(',', ':'))},"]
else:
    begin, end = f"-- >>> {plugin_id} >>>", f"-- <<< {plugin_id} <<<"
    body = [f'o.bind("{key}", "IP config", "omarchy-shell shell toggle {plugin_id}")']

# The Omarchy menu's own JSONC rules (MenuModel.stripJsonc): whole-line //
# comments are dropped and trailing commas are allowed. Nothing more, so a
# file it can't read is refused here too.
def menu_entries(text):
    stripped = re.sub(r"^\s*//[^\n]*(\n|$)", "", text, flags=re.M)
    stripped = re.sub(r",(\s*[}\]])", r"\1", stripped)
    if not stripped.strip():
        return {}
    try:
        parsed = json.loads(stripped)
    except ValueError:
        refuse("the Omarchy menu can't read this file as it is; leaving it alone.")
    if not isinstance(parsed, dict) or "items" in parsed:
        refuse("unexpected layout; leaving it alone.")
    return parsed

def find_block(lines):
    starts = [i for i, l in enumerate(lines) if l.rstrip("\n").strip() == begin.strip()]
    ends = [i for i, l in enumerate(lines) if l.rstrip("\n").strip() == end.strip()]
    if not starts and not ends:
        return None
    if len(starts) != 1 or len(ends) != 1 or ends[0] < starts[0]:
        refuse("its IP config marker lines are out of order; edit it by hand.")
    return starts[0], ends[0]

if os.path.islink(path):
    refuse("is a symlink; leaving it alone.")
exists = os.path.exists(path)
if exists:
    st = os.stat(path)
    if not os.path.isfile(path) or st.st_uid != os.getuid():
        refuse("isn't a regular file of yours; leaving it alone.")
    with open(path, encoding="utf-8") as f:
        original = f.read()
elif kind == "menu" and op == "add":
    original = "{\n}\n"
else:
    if op == "add":
        refuse("doesn't exist.")
    sys.exit(1 if op == "has" else 0)

lines = original.splitlines(keepends=True)
block = find_block(lines)

if op == "has":
    sys.exit(0 if block else 1)

def write(text):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".ip-config.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, (os.stat(path).st_mode & 0o7777) if exists else 0o644)
        if exists:
            with open(path, encoding="utf-8") as f:
                if os.path.islink(path) or f.read() != original:
                    refuse("changed while it was being edited; try again.")
        elif os.path.lexists(path):
            refuse("appeared while it was being edited; try again.")
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

if op == "add":
    if block:
        sys.exit(0)
    if kind == "menu":
        before = menu_entries(original)
        if entry_id in before:
            refuse(f"already has a {entry_id} entry; leaving it alone.")
        # Insert before the object's closing brace, adding a comma first if
        # the entry before it doesn't end with one.
        live = re.sub(r"^\s*//[^\n]*$", lambda m: " " * len(m.group(0)), original, flags=re.M)
        close = live.rfind("}")
        if close < 0:
            refuse("has no closing brace; leaving it alone.")
        prev = live[:close].rstrip()
        comma = [] if prev.endswith(("{", ",")) else ["  ,"]
        head = original[:close]
        if not head.endswith("\n"):
            head += "\n"
        text = head + "\n".join([begin] + comma + body + [end]) + "\n" + original[close:]
        expected = dict(before)
        expected[entry_id] = entry
        if menu_entries(text) != expected:
            refuse("couldn't add the entry cleanly; leaving it alone.")
    else:
        text = original
        if text and not text.endswith("\n"):
            text += "\n"
        text += "\n" + "\n".join([begin] + body + [end]) + "\n"
    write(text)
    sys.exit(0)

# remove
if not block:
    sys.exit(0)
start, stop = block
inside = [l.rstrip("\n") for l in lines[start + 1:stop]]
# The key block must be exactly ours. The menu block is checked by parsing
# instead, so a block written by an older version still comes out.
if kind == "key" and inside != body:
    refuse("the IP config block was edited by hand; remove it yourself.")
if kind == "menu":
    try:
        ours = json.loads("{" + "".join(inside).strip().strip(",") + "}")
    except ValueError:
        ours = None
    if not isinstance(ours, dict) or list(ours) != [entry_id]:
        refuse("the IP config block was edited by hand; remove it yourself.")
# Also take the blank line `add` put before the key block.
if kind == "key" and start > 0 and not lines[start - 1].strip():
    start -= 1
text = "".join(lines[:start] + lines[stop + 1:])
if kind == "menu":
    expected = menu_entries(original)
    expected.pop(entry_id, None)
    if menu_entries(text) != expected:
        refuse("removing the entry would change other entries; remove it yourself.")
write(text)
PY
}

# What SHORTCUT_KEY is bound to right now, if anything. Fails if Hyprland
# can't be asked.
key_binding() {
  local binds
  binds=$(hyprctl binds -j 2>/dev/null) || return 1
  # SUPER (64) + ALT (8); key names are reported as typed, so compare loosely.
  jq -er 'map(select(.modmask == 72 and (.key | ascii_upcase) == "N" and (.submap // "") == ""))
    | if length == 0 then "" else (.[0].description // "" | if . == "" then "something" else . end) end' <<<"$binds"
}

# Yes/no in the terminal; --yes answers yes, and without a terminal it's no.
ask() {
  ((ASSUME_YES)) && return 0
  [[ -t 0 && -t 1 ]] || return 1
  if command -v gum >/dev/null; then
    gum confirm "$1"
  else
    local reply
    read -rp "$1 [y/N] " reply && [[ $reply == [yY]* ]]
  fi
}

cmd_setup() {
  local rc bound errors_before errors_after
  ASSUME_YES=0
  [[ ${1:-} == --yes || ${1:-} == -y ]] && ASSUME_YES=1
  if ((! ASSUME_YES)) && ! [[ -t 0 && -t 1 ]]; then
    echo "Run this in a terminal, or pass --yes." >&2
    return 1
  fi
  mkdir -p "${OFFERED_FILE%/*}" && touch "$OFFERED_FILE"

  shortcut_block has menu "$MENU_FILE"
  rc=$?
  if ((rc == 0)); then
    echo "Already in Setup › Network."
  elif ((rc == 1)) && ask "Add IP config to Setup › Network in the Omarchy menu?"; then
    shortcut_block add menu "$MENU_FILE" && echo "Added to Setup › Network."
  fi

  shortcut_block has key "$BINDINGS_FILE"
  rc=$?
  if ((rc == 0)); then
    echo "$SHORTCUT_KEY already opens IP config."
  elif ((rc == 1)); then
    if ! bound=$(key_binding); then
      echo "Couldn't ask Hyprland about $SHORTCUT_KEY; not binding it." >&2
    elif [[ -n $bound ]]; then
      echo "$SHORTCUT_KEY is already bound ($bound); leaving it. Bind another key in $BINDINGS_FILE if you like."
    elif ask "Bind $SHORTCUT_KEY to open IP config?"; then
      errors_before=$(hyprctl configerrors 2>/dev/null)
      if shortcut_block add key "$BINDINGS_FILE"; then
        hyprctl reload >/dev/null 2>&1
        errors_after=$(hyprctl configerrors 2>/dev/null)
        if [[ $errors_after != "$errors_before" ]]; then
          shortcut_block remove key "$BINDINGS_FILE"
          hyprctl reload >/dev/null 2>&1
          echo "Hyprland reported a config error after binding $SHORTCUT_KEY, so it was taken out again:" >&2
          echo "$errors_after" >&2
          return 1
        fi
        echo "$SHORTCUT_KEY now opens IP config."
      fi
    fi
  fi

  # Root, so never on --yes: only when asked in the terminal. setup-logging
  # makes its own checks and asks for the password itself.
  if [[ -f $LOG_CONF ]] && grep -qxF "$LOG_MARKER" "$LOG_CONF" 2>/dev/null && read_logging && dhcp4_debug; then
    echo "DHCP packet logging is already on."
  elif ((! ASSUME_YES)) && ask "Optional: also show every DHCP packet (Discover, Offer, Request, Ack)? Requires sudo to enable."; then
    cmd_setup_logging
  fi
  return 0
}

cmd_remove_shortcuts() {
  local failed=0
  shortcut_block remove menu "$MENU_FILE" || failed=1
  if shortcut_block has key "$BINDINGS_FILE"; then
    if shortcut_block remove key "$BINDINGS_FILE"; then
      hyprctl reload >/dev/null 2>&1
    else
      failed=1
    fi
  fi
  ((failed)) && return 1
  echo "IP config shortcuts removed."
}

# Once, the first time the plugin loads: offer setup in a notification.
# Nothing is changed unless the user clicks it, and that opens a terminal
# where each change is asked about again.
cmd_offer_setup() {
  local self choice
  # Created exclusively (noclobber), so when several reloads start this at
  # once only one of them gets past here.
  mkdir -p "${OFFERED_FILE%/*}" 2>/dev/null || return 0
  (set -C; : >"$OFFERED_FILE") 2>/dev/null || return 0
  shortcut_block has menu "$MENU_FILE" 2>/dev/null && shortcut_block has key "$BINDINGS_FILE" 2>/dev/null && return 0
  # The plugin loads with the shell, which is also the notification server,
  # so give that a moment to come up. If it never does, or sending fails,
  # hand the marker back so the offer is made on a later load instead.
  for _ in {1..60}; do
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.NameHasOwner org.freedesktop.Notifications 2>/dev/null | grep -q true && break
    sleep 0.5
  done
  # Clicking the notification is the "default" action; Omarchy's notifications
  # show no buttons, so that's the only choice. Dismissing it is "no".
  if ! choice=$(notify -A default="Set up" "IP config" \
    "Click to add it to Setup › Network, bind $SHORTCUT_KEY and choose optional DHCP logging. Or later: ip-config setup"); then
    rm -f "$OFFERED_FILE"
    return 0
  fi
  [[ $choice == default ]] || return 0
  self=$(realpath "${BASH_SOURCE[0]}") || return 0
  omarchy-launch-floating-terminal-with-presentation "$(printf '%q' "$self") setup"
}

case "${1:-}" in
  list) cmd_list ;;
  watch) cmd_watch ;;
  setup-logging) cmd_setup_logging ;;
  remove-logging) cmd_remove_logging ;;
  setup) cmd_setup "${2:-}" ;;
  remove-shortcuts) cmd_remove_shortcuts ;;
  offer-setup) cmd_offer_setup ;;
  toggle | dhcp | prefill) [[ -n ${2:-} ]] && "cmd_$1" "$2" ;;
  static) [[ -n ${2:-} ]] && cmd_static "$2" "${3:-}" ;;
  *)
    echo "usage: ip-config list | toggle <dev> | dhcp <dev> | static <dev> <input> | prefill <dev>" >&2
    exit 1
    ;;
esac
