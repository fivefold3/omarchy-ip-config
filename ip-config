#!/bin/bash
# NetworkManager backend for the IP config shell plugin.
#
#   ip-config list                  One TSV line per Wi-Fi/Ethernet adapter:
#                                   device type enabled connection method address state
#                                   lease-expiry (epoch seconds, DHCP only)
#   ip-config toggle <dev>          Wi-Fi: radio off/on. Ethernet: disconnect/connect the device.
#   ip-config dhcp <dev>            Switch to DHCP, saving the current static settings first.
#   ip-config static <dev> <input>  input = "IP[/mask] [gateway] [dns...]", or "dhcp".
#                                   A missing mask means /24; missing DNS uses the gateway.
#   ip-config watch                 Stream DHCP progress for all adapters (see cmd_watch).
#   ip-config setup-logging         Optional, run by hand: turn on DHCP packet logging (root).
#   ip-config remove-logging        Undo setup-logging (root).
#   ip-config prefill <dev>         Current static settings, or the ones saved by the last
#                                   switch to DHCP, as "IP/mask gateway dns...".
#
# dhcp and static report the connection stages while it comes back up, one
# "status<TAB>text" line per stage. DHCP packet steps come from `watch`.

set -uo pipefail

# Static settings are saved on the NetworkManager profile itself (as user data),
# so they survive a switch to DHCP no matter what tool set them.
SAVED_KEY=ip-config.static-ipv4

notify() { notify-send -a "IP config" "$@"; }

fail() {
  notify -u critical "$@"
  exit 1
}

dev_field() { nmcli -g "$1" dev show "$2" 2>/dev/null; }
con_field() { nmcli -g "$1" con show "$2" 2>/dev/null; }

# The profile the device is using now, else the most recently used profile for it.
dev_profile() {
  local dev=$1 type name t ts best="" best_ts=-1 key val
  local -a names=()
  local -A stamp iface
  # Type and active profile in one call.
  { read -r t; IFS= read -r name; } < <(nmcli -g GENERAL.TYPE,GENERAL.CONNECTION dev show "$dev" 2>/dev/null)
  if [[ -n $name ]]; then
    echo "$name"
    return
  fi
  [[ $t == wifi ]] && type=802-11-wireless || type=802-3-ethernet
  while IFS=: read -r t ts name; do
    [[ $t == "$type" ]] || continue
    name=${name//\\:/:}
    names+=("$name")
    stamp[$name]=$ts
  done < <(nmcli -t -f TYPE,TIMESTAMP,NAME con show)
  ((${#names[@]})) || return 0
  while IFS= read -r line; do
    key=${line%%:*}
    val=${line#*:}
    case "$key" in
      connection.id) name=$val ;;
      connection.interface-name) iface[$name]=$val ;;
    esac
  done < <(nmcli -t -e no -f connection.id,connection.interface-name con show "${names[@]}")
  for name in "${names[@]}"; do
    [[ -z ${iface[$name]:-} || ${iface[$name]} == "$dev" ]] || continue
    if ((${stamp[$name]:-0} > best_ts)); then best=$name; best_ts=${stamp[$name]:-0}; fi
  done
  [[ -n $best ]] && echo "$best"
}

# A profile's saved user data, read over D-Bus (much faster than starting libnm).
user_data_get() {
  local con=$1 key=$2 path
  path=$(nmcli -t -f NAME,DBUS-PATH con show | awk -F: -v n="$con" '$1 == n { print $2 }')
  [[ -n $path ]] || return 0
  gdbus call --system --dest org.freedesktop.NetworkManager --object-path "$path" \
    --method org.freedesktop.NetworkManager.Settings.Connection.GetSettings |
    grep -o "'$key': '[^']*'" | sed "s/^'$key': '//; s/'\$//"
}

# nmcli can't write profile user data, so saving goes through libnm.
user_data() {
  python3 - "$@" <<'PY'
import sys, warnings, gi
warnings.filterwarnings("ignore", category=DeprecationWarning)
gi.require_version("NM", "1.0")
from gi.repository import NM

op, name, key = sys.argv[1:4]
con = next((c for c in NM.Client.new(None).get_connections() if c.get_id() == name), None)
if con is None:
    sys.exit(1)
setting = con.get_setting(NM.SettingUser)
if op == "get":
    print((setting.get_data(key) if setting else None) or "")
else:
    if setting is None:
        setting = NM.SettingUser.new()
        con.add_setting(setting)
    setting.set_data(key, sys.argv[4])
    con.commit_changes(True, None)
PY
}

# "IP/mask gateway dns..." from a profile's current ipv4 settings.
static_line() {
  local con=$1 addr gw dns
  addr=$(con_field ipv4.addresses "$con" | cut -d, -f1 | tr -d ' ')
  gw=$(con_field ipv4.gateway "$con")
  dns=$(con_field ipv4.dns "$con" | tr ',' ' ')
  [[ -n $addr ]] && echo "$addr${gw:+ $gw}${dns:+ $dns}"
}

status() { printf 'status\t%s\n' "$1"; }

# NetworkManager device state -> progress text. NM's DHCP client doesn't expose
# the individual DHCP packets, so this is as fine-grained as it gets.
stage_text() {
  local method=$1
  case "${2%% *}" in
    110) echo "Releasing old address…" ;;
    40) echo "Preparing…" ;;
    50) echo "Configuring link…" ;;
    60) echo "Authenticating…" ;;
    70) [[ $method == auto ]] && echo "Requesting DHCP lease…" || echo "Setting address…" ;;
    80) echo "Checking address…" ;;
    90) echo "Starting…" ;;
  esac
}

# DHCP packets (Discover, Offer, Request, Ack) only reach the journal when
# NetworkManager's DHCP4 log domain is at DEBUG; see cmd_setup_logging.
dhcp_logging() { nmcli general logging | grep -qE 'DHCP4:(DEBUG|TRACE)'; }


# Bring the profile up, reporting each stage of the activation as it happens.
# DHCP itself is reported by `ip-config watch`, which the plugin runs while open.
activate() {
  local dev=$1 con=$2 method out pid rc code text last=""
  method=$(con_field ipv4.method "$con")
  out=$(mktemp)
  nmcli con up "$con" >"$out" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    code=$(dev_field GENERAL.STATE "$dev")
    code=${code%% *}
    # For DHCP, the watcher's packet steps replace the generic "requesting" stage.
    if [[ $method == auto && $code == 70 ]]; then text=""; else text=$(stage_text "$method" "$code"); fi
    if [[ -n $text && $text != "$last" ]]; then
      status "$text"
      last=$text
    fi
    sleep 0.15
  done
  wait "$pid"
  rc=$?
  if ((rc != 0)); then
    notify -u critical "Failed: $con" "$(cat "$out")"
    rm -f "$out"
    exit 1
  fi
  rm -f "$out"
}

# Modify the adapter's profile, then reactivate it if the adapter is up.
# A disabled or unplugged adapter just keeps the saved settings.
apply() {
  local dev=$1 con out
  shift
  con=$(dev_profile "$dev")
  [[ -n $con ]] || fail "No profile for $dev"
  out=$(nmcli con mod "$con" "$@" 2>&1) || fail "Failed: $con" "$out"
  if [[ -n $(dev_field GENERAL.CONNECTION "$dev") ]]; then
    activate "$dev" "$con"
  fi
}

# Follows NetworkManager's journal and reports DHCP progress for every adapter,
# whoever started it (this plugin, a cable being plugged in, a reconnect):
#   event<TAB>device<TAB>text     (empty text: the lease is done)
# Steps are reported as they happen; the plugin paces them for display.
cmd_watch() {
  local line dev ip text
  declare -A last canceled
  coproc JOURNAL { exec journalctl -u NetworkManager -f -n 0 -o cat 2>/dev/null; }
  trap 'kill "$JOURNAL_PID" 2>/dev/null' EXIT
  trap 'exit 0' TERM INT
  while IFS= read -r line <&"${JOURNAL[0]}"; do
    [[ $line =~ dhcp4\ \(([^\)]+)\):\ (.*) ]] || continue
    dev=${BASH_REMATCH[1]}
    line=${BASH_REMATCH[2]}
    ip=""
    [[ $line =~ \ of\ ([0-9.]+) ]] && ip=${BASH_REMATCH[1]}
    # Tearing a connection down logs "canceled DHCP transaction" immediately
    # followed by a "beginning transaction" that never goes anywhere; skip it.
    if [[ $line == "canceled DHCP transaction"* ]]; then
      canceled[$dev]=1
      continue
    fi
    if [[ -n ${canceled[$dev]:-} ]]; then
      unset "canceled[$dev]"
      [[ $line == "activation: beginning transaction"* ]] && continue
    fi
    case "$line" in
      "activation: beginning transaction"*) text="Starting DHCP…" ;;
      "event: send DISCOVER"*) text="Discover…" ;;
      "event: received OFFER"*) text="Offer${ip:+ $ip}" ;;
      "event: send REQUEST"*) text="Request${ip:+ $ip}" ;;
      "event: received ACK"*) text="Ack${ip:+ $ip}" ;;
      "event: received NACK"*) text="Nak, retrying…" ;;
      "state changed new lease, address="*"acd pending"*) text="Checking for conflicts…" ;;
      "state changed new lease, address="*) text="" ;;
      *) continue ;;
    esac
    [[ -n $text && $text == "${last[$dev]:-}" ]] && continue
    last[$dev]=$text
    printf 'event\t%s\t%s\n' "$dev" "$text"
  done
}

# Optional DHCP packet logging, set up and removed by the user by hand (the
# plugin never runs these). Both need root, via polkit, and touch only:
#   - LOG_CONF, which carries LOG_MARKER so it's never mistaken for, or
#     written over, a file this plugin didn't create;
#   - the DHCP4 entry of NetworkManager's log domains. Every other domain and
#     the overall level stay as they are, now and in the saved config.
LOG_CONF=/etc/NetworkManager/conf.d/90-ip-config-dhcp-log.conf
LOG_MARKER="# Managed by the IP config Omarchy plugin (io.github.fivefold3.ip-config)."

# Current runtime log level and domains, with DHCP4 set to $1 ("" = inherit).
logging_with_dhcp4() {
  local level domains
  IFS=: read -r level domains < <(nmcli -t -f LEVEL,DOMAINS general logging)
  domains=${domains//\\:/:}   # nmcli -t escapes colons
  domains=$(tr ',' '\n' <<<"$domains" | grep -v '^DHCP4\(:.*\)\?$' | paste -sd,)
  echo "$level"
  echo "${domains:+$domains,}DHCP4${1:+:$1}"
}

cmd_setup_logging() {
  local line level domains
  if dhcp_logging && grep -qxF "$LOG_MARKER" "$LOG_CONF" 2>/dev/null; then
    echo "DHCP packet logging is already on."
    return 0
  fi
  # Add to an existing domains setting rather than replacing it. With none
  # set, "+=" alone would leave only DHCP4 enabled, so include the defaults.
  if NetworkManager --print-config 2>/dev/null | grep -q '^domains='; then
    line="domains+=DHCP4:DEBUG"
  else
    line="domains+=DEFAULT,DHCP4:DEBUG"
  fi
  { read -r level; read -r domains; } < <(logging_with_dhcp4 DEBUG)
  pkexec /bin/sh -c '
    conf=$1 marker=$2 line=$3 level=$4 domains=$5
    if [ -e "$conf" ] && ! grep -qxF "$marker" "$conf"; then
      echo "$conf already exists and was not created by this plugin; leaving it alone." >&2
      exit 3
    fi
    mkdir -p "$(dirname "$conf")" &&
      printf "%s\n%s\n%s\n" "$marker" "[logging]" "$line" >"$conf" &&
      chmod 644 "$conf" &&
      nmcli general logging level "$level" domains "$domains"
  ' sh "$LOG_CONF" "$LOG_MARKER" "$line" "$level" "$domains" &&
    echo "DHCP packet logging is on."
}

cmd_remove_logging() {
  local level domains
  if [[ -e $LOG_CONF ]] && ! grep -qxF "$LOG_MARKER" "$LOG_CONF"; then
    echo "$LOG_CONF was not created by this plugin; leaving it alone." >&2
    return 3
  fi
  { read -r level; read -r domains; } < <(logging_with_dhcp4 "")
  pkexec /bin/sh -c '
    conf=$1 marker=$2 level=$3 domains=$4
    if [ -e "$conf" ]; then
      grep -qxF "$marker" "$conf" || { echo "$conf was not created by this plugin; leaving it alone." >&2; exit 3; }
      rm -f "$conf"
    fi
    nmcli general logging level "$level" domains "$domains"
  ' sh "$LOG_CONF" "$LOG_MARKER" "$level" "$domains" &&
    echo "DHCP packet logging is off."
}

# Runs every 1.5s while the menu is open, so it makes four nmcli calls in
# total rather than several per adapter.
cmd_list() {
  local wifi_radio key val dev type state con enabled method addr expiry name t ts
  local -a devs=() profiles=()
  local -A dtype dstate dcon daddr dexpiry ptype pstamp piface pmethod paddr
  wifi_radio=$(nmcli radio wifi)

  # Every device in one call: blocks of KEY:VALUE lines.
  while IFS= read -r line; do
    key=${line%%:*}
    val=${line#*:}
    case "$key" in
      GENERAL.DEVICE) dev=$val; devs+=("$dev") ;;
      GENERAL.TYPE) dtype[$dev]=$val ;;
      GENERAL.STATE) val=${val#* (}; dstate[$dev]=${val%)} ;;
      GENERAL.CONNECTION) dcon[$dev]=$val ;;
      IP4.ADDRESS\[1\]) daddr[$dev]=$val ;;
      DHCP4.OPTION*) [[ $val == "expiry = "* ]] && dexpiry[$dev]=${val#expiry = } ;;
    esac
  done < <(nmcli -t -f GENERAL.DEVICE,GENERAL.TYPE,GENERAL.STATE,GENERAL.CONNECTION,IP4.ADDRESS,DHCP4.OPTION dev show)

  # Wi-Fi/Ethernet profiles. NAME goes last since it may itself contain colons.
  while IFS=: read -r t ts name; do
    [[ $t == 802-11-wireless || $t == 802-3-ethernet ]] || continue
    name=${name//\\:/:}
    profiles+=("$name")
    ptype[$name]=$t
    pstamp[$name]=$ts
  done < <(nmcli -t -f TYPE,TIMESTAMP,NAME con show)

  # Their settings, again in one call.
  if ((${#profiles[@]})); then
    while IFS= read -r line; do
      key=${line%%:*}
      val=${line#*:}
      case "$key" in
        connection.id) name=$val ;;
        connection.interface-name) piface[$name]=$val ;;
        ipv4.method) pmethod[$name]=$val ;;
        ipv4.addresses) paddr[$name]=${val%%,*} ;;
      esac
    done < <(nmcli -t -e no -f connection.id,connection.interface-name,ipv4.method,ipv4.addresses con show "${profiles[@]}")
  fi

  for dev in "${devs[@]}"; do
    type=${dtype[$dev]}
    state=${dstate[$dev]}
    case "$type" in
      wifi) [[ $wifi_radio == enabled ]] && enabled=1 || enabled=0 ;;
      ethernet) [[ $state == disconnected || $state == unmanaged ]] && enabled=0 || enabled=1 ;;
      *) continue ;;
    esac
    con=${dcon[$dev]:-}
    if [[ -z $con ]]; then
      # Not connected: the most recently used profile that fits this device.
      [[ $type == wifi ]] && t=802-11-wireless || t=802-3-ethernet
      ts=-1
      for name in "${profiles[@]}"; do
        [[ ${ptype[$name]} == "$t" ]] || continue
        [[ -z ${piface[$name]:-} || ${piface[$name]} == "$dev" ]] || continue
        if ((${pstamp[$name]:-0} > ts)); then con=$name; ts=${pstamp[$name]:-0}; fi
      done
    fi
    method=${pmethod[$con]:-}
    addr=${daddr[$dev]:-}
    # A static adapter that is down still shows its configured address.
    [[ -z $addr && $method == manual ]] && addr=${paddr[$con]:-}
    expiry=""
    [[ $method == auto && -n $addr ]] && expiry=${dexpiry[$dev]:-}
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$dev" "$type" "$enabled" "$con" "$method" "$addr" "$state" "$expiry"
  done
}

cmd_toggle() {
  local dev=$1 state out
  if [[ $(dev_field GENERAL.TYPE "$dev") == wifi ]]; then
    if [[ $(nmcli radio wifi) == enabled ]]; then
      nmcli radio wifi off
    else
      nmcli radio wifi on
    fi
    return
  fi
  state=$(dev_field GENERAL.STATE "$dev")
  # Unplugged: nothing to disconnect, and connecting can't succeed.
  [[ $state == *"(unavailable)"* ]] && return 0
  if [[ $state == *"(disconnected)"* || $state == *"(unmanaged)"* ]]; then
    out=$(nmcli dev connect "$dev" 2>&1) || fail "Failed: $dev" "$out"
  else
    out=$(nmcli dev disconnect "$dev" 2>&1) || fail "Failed: $dev" "$out"
  fi
}

cmd_dhcp() {
  local dev=$1 con line
  con=$(dev_profile "$dev")
  if [[ -n $con && $(con_field ipv4.method "$con") == manual ]]; then
    line=$(static_line "$con")
    [[ -n $line ]] && user_data set "$con" "$SAVED_KEY" "$line"
  fi
  apply "$dev" ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns ""
}

cmd_static() {
  local dev=$1 words ip gw dns
  read -ra words <<<"${2:-}"
  ip=${words[0]:-}
  gw=${words[1]:-}
  dns=$(IFS=,; echo "${words[*]:2}")
  [[ -n $ip ]] || return 0
  if [[ ${ip,,} == dhcp ]]; then
    cmd_dhcp "$dev"
    return
  fi
  [[ $ip == */* ]] || ip="$ip/24"
  apply "$dev" ipv4.method manual ipv4.addresses "$ip" ipv4.gateway "$gw" ipv4.dns "${dns:-$gw}"
}

cmd_prefill() {
  local con
  con=$(dev_profile "$1")
  [[ -n $con ]] || return 0
  if [[ $(con_field ipv4.method "$con") == manual ]]; then
    static_line "$con"
  else
    user_data_get "$con" "$SAVED_KEY"
  fi
}

case "${1:-}" in
  list) cmd_list ;;
  watch) cmd_watch ;;
  setup-logging) cmd_setup_logging ;;
  remove-logging) cmd_remove_logging ;;
  toggle | dhcp | prefill) [[ -n ${2:-} ]] && "cmd_$1" "$2" ;;
  static) [[ -n ${2:-} ]] && cmd_static "$2" "${3:-}" ;;
  *)
    echo "usage: ip-config list | toggle <dev> | dhcp <dev> | static <dev> <input> | prefill <dev>" >&2
    exit 1
    ;;
esac
